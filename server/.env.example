# Порт сервера
PORT=3001

# Окружение (production, development)
NODE_ENV=production

# Домен или IP адрес сервера (для CORS и клиента)
DOMAIN=localhost

# Бесплатно: console.groq.com → API Keys → Whisper
# GROQ_API_KEY=gsk_...
# или OpenAI Whisper:
# OPENAI_API_KEY=sk-...

# OAuth-привязки (Discord / Spotify / Steam) — как в Discord «Подключить»
# Discord: https://discord.com/developers/applications → OAuth2 → Redirect:
#   http://localhost:3001/api/connections/discord/callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# Spotify: https://developer.spotify.com/dashboard → Redirect:
#   http://localhost:3001/api/connections/spotify/callback
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Steam OpenID работает без ключа; для ника/аватара:
# STEAM_WEB_API_KEY=

# Публичный URL сервера для OAuth (если не localhost)
# OAUTH_PUBLIC_URL=http://localhost:3001
# CLIENT_URL=http://localhost:5173
