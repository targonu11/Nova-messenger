{
  "name": "nova-messenger-server",
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js",
    "prod": "NODE_ENV=production node index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop nova-server",
    "pm2:restart": "pm2 restart nova-server",
    "pm2:logs": "pm2 logs nova-server",
    "seed": "node -e \"import('./db.js').then(d => d.seedUsers())\"",
    "reset-db": "node reset-db.js",
    "export-accounts": "node export-accounts.js",
    "backup": "node create-backup.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.0",
    "multer": "^2.0.0",
    "socket.io": "^4.8.0",
    "sql.js": "^1.11.0",
    "uuid": "^10.0.0"
  }
}
